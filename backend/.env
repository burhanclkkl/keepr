# Keepr Backend Environment Variables

SECRET_KEY=keepr-super-secret-key-change-in-prod
JWT_SECRET_KEY=keepr-super-secret-key-change-in-prod
JWT_EXPIRATION_HOURS=24

# PostgreSQL connection string: postgresql://[user]:[password]@[host]:[port]/[database]
# Default is set to connect to 'keepr' database on localhost with 'postgres' user
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/keepr

# SMTP Email Configuration (Fill with your production credentials)
