# Keepr Backend — Environment Variables (ÖRNEK)
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun.
# `.env` ASLA commit edilmez (.gitignore ile korunur).

# ── Secrets ──────────────────────────────────────────────
# Üretim için rastgele üretin (birbirinden FARKLI olmalı):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
JWT_SECRET_KEY=
JWT_EXPIRATION_HOURS=24

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/keepr

# ── CORS (üretimde mutlaka daraltın) ─────────────────────
# Virgülle ayrılmış izinli origin listesi, örn: https://keepr.app
CORS_ORIGINS=*

# ── SMTP Email ───────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=Keepr
MAIL_FROM_EMAIL=no-reply@keepr.app

# ── OTP ──────────────────────────────────────────────────
OTP_EXPIRATION_MINUTES=10
OTP_LENGTH=6
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
KVKK_CURRENT_VERSION=2026-07

# ── Ortam ────────────────────────────────────────────────
# Üretimde 'production' olmalı — debug modunu ve mock endpointleri kapatır.
FLASK_ENV=development
